target: codex
name: config.toml
format: toml
suggested-path: ~/.codex/config.toml
===== artifact content begins =====
[model_providers]
  [model_providers.volcengine]
    name = "Volcengine"
    base_url = "https://example.com/v1"
    env_key = "VOLC_API_KEY"
    wire_api = "responses"
    requires_openai_auth = false
    [model_providers.volcengine.http_headers]
      X-Tenant = "engineering"
===== END agentcfg artifact =====

===== BEGIN agentcfg artifact =====
target: opencode
name: opencode.json
format: json
suggested-path: opencode.json
===== artifact content begins =====
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "volcengine": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volcengine",
      "options": {
        "apiKey": "{env:VOLC_API_KEY}",
        "baseURL": "https://example.com/v1",
        "headers": {
          "X-Gateway-Key": "{env:GATEWAY_KEY}",
          "X-Tenant": "engineering"
        }
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "tools": true
        }
      }
    }
  },
  "model": "volcengine/glm-5.3"
}
===== END agentcfg artifact =====
