target: pi
name: agentcfg-providers.ts
format: typescript
suggested-path: ~/.pi/agent/extensions/agentcfg-providers.ts
===== artifact content begins =====
// Generated by agentcfg. Do not edit.
// Install: copy to ~/.pi/agent/extensions/ and restart pi.

export default function (pi: any) {
  pi.registerProvider({
    id: "volcengine",
    name: "Volcengine",
    api: "openai-responses",
    baseUrl: "https://example.com/v1",
    apiKey: "$VOLC_API_KEY",
    headers: {
      "X-Tenant": "engineering",
      "X-Gateway-Key": "$GATEWAY_KEY",
    },
    models: [
      {
        id: "glm-5.3",
        name: "GLM-5.3",
        input: ["text", "image"],
        reasoning: true,
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
        contextWindow: 128000,
        maxTokens: 8192,
      },
    ],
  });
}
===== END agentcfg artifact =====
