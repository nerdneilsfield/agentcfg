===== BEGIN agentcfg artifact =====
target: codex
name: config.toml
format: toml
suggested-path: ~/.codex/config.toml
===== artifact content begins =====
model_provider = "volcengine"
model = "glm-5.3"

[model_providers]
  [model_providers.volcengine]
    name = "Volcengine"
    base_url = "https://example.com/v1"
    env_key = "VOLC_API_KEY"
    wire_api = "responses"
    requires_openai_auth = false
    [model_providers.volcengine.http_headers]
      X-Tenant = "engineering"
    [model_providers.volcengine.env_http_headers]
      X-Gateway-Key = "GATEWAY_KEY"
===== END agentcfg artifact =====

===== BEGIN agentcfg artifact =====
target: pi
name: models.json
format: json
suggested-path: ~/.pi/agent/models.json
===== artifact content begins =====
{
  "providers": {
    "volcengine": {
      "api": "openai-responses",
      "apiKey": "$VOLC_API_KEY",
      "baseUrl": "https://example.com/v1",
      "headers": {
        "X-Gateway-Key": "$GATEWAY_KEY",
        "X-Tenant": "engineering"
      },
      "models": [
        {
          "contextWindow": 128000,
          "cost": {
            "cacheRead": 0,
            "cacheWrite": 0,
            "input": 0,
            "output": 0
          },
          "id": "glm-5.3",
          "input": [
            "text",
            "image"
          ],
          "maxTokens": 8192,
          "name": "GLM-5.3",
          "reasoning": true
        }
      ]
    }
  }
}
===== END agentcfg artifact =====
