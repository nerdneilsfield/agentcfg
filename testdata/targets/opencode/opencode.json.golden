{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "volcengine": {
      "name": "Volcengine",
      "env": [
        "VOLC_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://example.com/v1"
      },
      "headers": {
        "X-Gateway-Key": "{env:GATEWAY_KEY}",
        "X-Tenant": "engineering"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "volcengine/glm-5.3"
}
